# Build SiYuan Windows kernel executable in Docker.
# Output: SiYuan-Kernel.exe
#
# Example:
#   docker build -f Dockerfile.win-exe -t siyuan-win-exe .
#   docker create --name siyuan-win-exe-temp siyuan-win-exe
#   docker cp siyuan-win-exe-temp:/SiYuan-Kernel.exe .
#   docker rm siyuan-win-exe-temp

FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS go-win-build

WORKDIR /kernel

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-mingw-w64-x86-64 \
    binutils-mingw-w64-x86-64 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV GO111MODULE=on
ENV CGO_ENABLED=1
ENV GOOS=windows
ENV GOARCH=amd64
ENV CC=x86_64-w64-mingw32-gcc
ENV CXX=x86_64-w64-mingw32-g++

ADD kernel/go.* ./
RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod \
    go mod download

ADD kernel/ ./
RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod \
    go install github.com/josephspurrier/goversioninfo/cmd/goversioninfo@latest && \
    /go/bin/goversioninfo -platform-specific=true -icon=resource/icon.ico -manifest=resource/goversioninfo.exe.manifest

RUN --mount=type=cache,target=/root/.cache/go-build --mount=type=cache,target=/go/pkg/mod \
    go build -tags fts5 -v -o /artifacts/SiYuan-Kernel.exe -ldflags "-s -w -H=windowsgui" .

FROM scratch AS artifact
COPY --from=go-win-build /artifacts/SiYuan-Kernel.exe /SiYuan-Kernel.exe
